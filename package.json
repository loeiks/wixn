{
  "type": "module",
  "name": "wixn",
  "version": "1.5.0",
  "description": "Basic tool to install, update and uninstall multiple NPM packages at the same time with `wix` CLI.",
  "bin": {
    "wixn": "./index.js"
  },
  "keywords": [
    "loeiks",
    "wixn",
    "wix install"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "url": "git@github.com:loeiks/wixn.git",
    "type": "git"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "terser": "^5.48.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "bun --bun run tsc && terser ./index.js -o ./index.js"
  }
}